# ── Core ──
NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/graas
PUBLIC_BASE_URL=http://localhost:8000

# ── Auth ──
# Use a unique secret of at least 32 characters in production
JWT_SECRET=
JWT_EXPIRY=8h
# Comma-separated allowlist (add your LAN origin for device testing)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── LLM — pick ONE cloud key (preferred) OR keep local llama.cpp ──
# Priority: LLM_API_KEY → OPENROUTER_API_KEY → OPENAI_API_KEY → NVIDIA_API_KEY → LOCAL_LLM_*
#
# OpenRouter (many models, one key): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# OpenAI:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
#
# NVIDIA NIM:
# NVIDIA_API_KEY=
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#
# Generic OpenAI-compatible (Groq, Together, Azure, etc.):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# Optional overrides (cloud defaults: vision ON, tools ON)
# LLM_VISION_ENABLED=true
# LLM_TOOLS_ENABLED=true

# ── Local LLM fallback (llama.cpp / Ollama — used when no cloud key) ──
LOCAL_LLM_MODEL_PATH=E:/autobot projects/GRAAS/gemma2b-cyberpeace-victim-ocr-q4_k_m.gguf
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=gemma2b-cyberpeace-victim-ocr-q4_k_m
LOCAL_LLM_VISION_ENABLED=false
LOCAL_LLM_TOOLS_ENABLED=false
# Self-hosted Whisper ASR (use port 9002 — MinIO uses :9000)
WHISPER_ENDPOINT=http://localhost:9002/asr

# ── OSINT — Already live ──
VIRUSTOTAL_API_KEY=
WHOISXML_API_KEY=
SHODAN_API_KEY=

# ── OSINT — Phase 3 ──
NUMVERIFY_API_KEY=
TRUECALLER_API_KEY=
ABUSEIPDB_API_KEY=
ETHERSCAN_API_KEY=
TRONSCAN_API_KEY=
HAVEIBEENPWNED_API_KEY=
HUNTER_IO_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
URLSCAN_API_KEY=

# ── Graph DB (Phase 4) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=grasspass123
# Retries when API starts before Neo4j Bolt is ready (Docker)
NEO4J_CONNECT_RETRIES=12
NEO4J_CONNECT_RETRY_MS=5000

# ── Storage (Phase 5) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=grass-evidence

# Block private IPs in outbound OSINT axios (safeHttp). Set false only for local debugging.
SSRF_PROTECTION=true

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Redis (Phase 7) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
PLAYWRIGHT_WORKER_URL=http://localhost:8001

# ── Phase 9 Agent ──
AGENT_MAX_ITERATIONS=40
AGENT_ITERATION_TIMEOUT_MS=20000
AGENT_SCREENSHOT_QUALITY=85
SCREENSHOT_MAX_WIDTH_PX=1200
PLAYWRIGHT_SCREENSHOT_WORKER_URL=http://localhost:8001

# ── PDF / Puppeteer (Phase 6) ──
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=
