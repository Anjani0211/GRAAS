# All-in-one free Render image: MongoDB base + Node API (single service).
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM mongo:7 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8000
ENV MONGODB_URI=mongodb://127.0.0.1:27017/graas
ENV PATH="/opt/node/bin:${PATH}"

# Pre-downloaded on host (no apt/curl inside image)
COPY .node-bin /opt/node
RUN mkdir -p /data/db /app/uploads/evidence \
  && node -v && npm -v

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY start-bundle.sh /start-bundle.sh
RUN chmod +x /start-bundle.sh

EXPOSE 8000
CMD ["/start-bundle.sh"]
