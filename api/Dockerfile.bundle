# All-in-one free Render image: MongoDB + Node API (git auto-deploy friendly).
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM mongo:7 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8000
ENV MONGODB_URI=mongodb://127.0.0.1:27017/graas
ENV PATH="/opt/node/bin:${PATH}"

# Official Node tarball (gzip) — works on Render builders without host pre-download
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && curl -fsSL https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.gz \
    | tar -xz -C /opt \
  && mv /opt/node-v22.14.0-linux-x64 /opt/node \
  && node -v && npm -v \
  && mkdir -p /data/db /app/uploads/evidence \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY start-bundle.sh /start-bundle.sh
RUN chmod +x /start-bundle.sh

EXPOSE 8000
CMD ["/start-bundle.sh"]
