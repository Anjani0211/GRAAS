{
  "name": "graas-api",
  "version": "1.0.0",
  "description": "GRAAS API — Node.js + Express + MongoDB backend",
  "main": "dist/app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node ../scripts/check-node.mjs",
    "prestart": "node ../scripts/check-node.mjs",
    "dev": "tsx watch src/app.ts",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');const s=p.join('src','templates'),d=p.join('dist','templates');if(fs.existsSync(s))fs.cpSync(s,d,{recursive:true});\"",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/**/*.test.ts",
    "migrate:evidence": "tsx scripts/migrateEvidenceToMinio.ts",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "llm:server": "powershell -ExecutionPolicy Bypass -File scripts/start-local-llm.ps1",
    "e2e:report": "tsx scripts/e2ePipelineReport.ts",
    "pipeline:anjani-sample": "tsx scripts/runAnjaniSamplePipeline.ts",
    "export:report": "tsx scripts/exportReportDocxPdf.ts"
  },
  "keywords": [
    "graas",
    "cybercrime",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@langchain/core": "^1.1.42",
    "@langchain/openai": "^1.4.7",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "exif-parser": "^0.1.12",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "mustache": "^4.2.0",
    "neo4j-driver": "^6.0.1",
    "node-cron": "^4.2.1",
    "openai": "^6.39.1",
    "p-queue": "^9.2.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.42.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^3.15.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.9.9",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
