# Public API base URL. Leave unset in local dev — the browser then defaults to
# the same hostname the app was opened on, port 8000 (e.g. http://localhost:8000/api).
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional: show the seeded admin email hint on the login page in development only.
# Copy this file to .env.local to enable. Never set in production.
# Password is intentionally omitted from the client — use `make seed` / SETUP.md.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@grass.local
